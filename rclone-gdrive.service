[Unit]
Description=Rclone Mount for Google Drive (gdrive)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rclone mount gdrive: /home/ubuntu/mnt/google_drive \
    --config /home/ubuntu/.config/rclone/rclone.conf \
    --vfs-cache-mode full \
    --vfs-cache-max-size 5G \
    --vfs-cache-max-age 4h \
    --vfs-cache-poll-interval 5m \
    --allow-other \
    --poll-interval 1m \
    --dir-cache-time 1000h \
    --attr-timeout 1000h \
    --vfs-read-chunk-size 32M \
    --vfs-read-chunk-size-limit 1G \
    --buffer-size 32M \
    --log-file /home/ubuntu/.cache/rclone/rclone.log \
    --log-level INFO
ExecStop=/bin/fusermount -u -z /home/ubuntu/mnt/google_drive
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
