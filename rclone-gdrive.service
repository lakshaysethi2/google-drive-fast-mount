[Unit]
Description=Rclone Mount for Google Drive (gdrive)
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify makes systemd wait until the mountpoint is actually ready, and
# lets rclone publish live VFS cache stats into `systemctl --user status`.
# If your rclone is very old and the service times out, change this to `simple`.
Type=notify

# systemd user units expand %h to the user's home directory, so this file is
# portable across machines/users with no editing required.
#
# NOTE: systemd runs units without HOME/PATH, so `~` is NOT expanded by rclone.
# --config and --cache-dir must always be absolute paths.
# Clear a stale FUSE endpoint left by a previous failed start; without this
# rclone hits "mountpoint is not empty" and the service restart-loops.
# NOTE: on fuse3-only distros (Arch) the binary is fusermount3; on Debian it
# may be /bin/fusermount. Running the setup script picks the right one.
ExecStartPre=-/usr/bin/fusermount3 -u -z %h/mnt/google_drive
ExecStart=/usr/bin/rclone mount gdrive: %h/mnt/google_drive \
    --config %h/.config/rclone/rclone.conf \
    --cache-dir %h/.cache/rclone \
    --vfs-cache-mode full \
    --vfs-cache-max-size 5G \
    --vfs-cache-max-age 1h \
    --vfs-cache-min-free-space 5G \
    --vfs-cache-poll-interval 1m \
    --allow-other \
    --poll-interval 1m \
    --dir-cache-time 1000h \
    --attr-timeout 1000h \
    --vfs-read-chunk-size 32M \
    --vfs-read-chunk-size-limit 1G \
    --buffer-size 32M \
    --transfers 4 \
    --drive-chunk-size 64M \
    --drive-upload-cutoff 64M \
    --drive-pacer-min-sleep 10ms \
    --drive-pacer-burst 200 \
    --log-file %h/.cache/rclone/rclone.log \
    --log-level INFO \
    --stats 30s \
    --stats-one-line
ExecStop=/usr/bin/fusermount3 -u -z %h/mnt/google_drive
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
